# Copy this to a file called .env (on the server) and fill in real values.
# ensure .env is in .gitignore and never commited to github.

# Your domain, already pointing at the VPS IP (an A record)
DOMAIN=trello.yourdomain.com
# Email Let's Encrypt uses for expiry warnings
CERTBOT_EMAIL=you@example.com

# Database (the db container creates this user/database on first start)
POSTGRES_DB=taskmanager
POSTGRES_USER=trello
POSTGRES_PASSWORD=change_me_to_something_long

# JWT signing secret: must be at least 32 characters for HS256.
# Generate one on the server with:  openssl rand -base64 48
JWT_SECRET=change_me
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000
